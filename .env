# ─────────────────────────────────────────────────────────────
# QR Studio — environment variables
# Copy to `.env.local` and fill in. The CORE APP NEEDS NONE OF THESE
# (QR + short links work fully client-side). These are only for the
# OPTIONAL backend that enables cross-device short links, dynamic QR
# redirects, and real scan/click tracking.
# ─────────────────────────────────────────────────────────────

# Public base URL — used for SEO canonical/OG tags and as the short-link base.
NEXT_PUBLIC_SITE_URL=https://qr.k-innovative.com

# --- Pick ONE datastore and wire it into the API routes (see README) ---

# Option A — Supabase
SUPABASE_URL=https://gxxphwdoscjncjfjxmrh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imd4eHBod2Rvc2NqbmNqZmp4bXJoIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3OTg2NDQ0MiwiZXhwIjoyMDk1NDQwNDQyfQ.EXATDSjHJJq9uTOMk--W7dIayeEohflgABk6pbAwfok

# Option B — Vercel KV / Upstash Redis
KV_REST_API_URL=
